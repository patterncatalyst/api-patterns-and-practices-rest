   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Under the GIL, threadpool-offloaded sync handlers still contend for the interpreter lock during CPU-bound work; only I/O-bound release points actually parallelize. Free-threaded (no-GIL) Python builds change this trade-off but are not yet the default.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Under the GIL, threadpool-offloaded sync handlers still contend for the interpreter lock during CPU-bound work; only I/O-bound release points actually parallelize. Free-threaded (no-GIL) Python builds change this trade-off but are not yet the default.",
   "lineHeight": 1.25,
   "baseline": 12
  }
 ],
