   "seed": 987205933,
   "versionNonce": 440017711,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Route vs. Ingress: a Route is OpenShift's own resource (host + TLS edge/passthrough/reencrypt on the Router); vanilla Kubernetes uses an Ingress against an Ingress controller instead \u2014 the two aren't interchangeable.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Route vs. Ingress: a Route is OpenShift's own resource (host + TLS edge/passthrough/reencrypt on the Router); vanilla Kubernetes uses an Ingress against an Ingress controller instead \u2014 the two aren't interchangeable.",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t809840845",
   "type": "text",
   "x": 470.0,
   "y": 550,
   "width": 825.0000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#b8650a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1952496400,
   "versionNonce": 1340220799,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The cluster builds its own image from source via S2I and deploys it \u2014 no external registry or CI push required to run on CRC.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The cluster builds its own image from source via S2I and deploys it \u2014 no external registry or CI push required to run on CRC.",
   "lineHeight": 1.25,
   "baseline": 12
  }
