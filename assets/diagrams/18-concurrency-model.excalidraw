   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Reactive/virtual threads and the asyncio event loop scale by never parking a real OS thread on I/O \u2014 blocking models scale only as far as the thread pool, then requests queue or fail.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Reactive/virtual threads and the asyncio event loop scale by never parking a real OS thread on I/O \u2014 blocking models scale only as far as the thread pool, then requests queue or fail.",
   "lineHeight": 1.25,
   "baseline": 12
  }
